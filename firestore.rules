rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.nama is string && data.nama.size() > 0 && data.nama.size() <= 100
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.lastActive is timestamp && data.lastActive <= request.time
        && data.skorRealitasTerakhir is number && data.skorRealitasTerakhir >= 0 && data.skorRealitasTerakhir <= 100;
    }

    function isValidSession(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.ceritaPengguna is string && data.ceritaPengguna.size() > 0
        && data.diagnosis is string
        && data.petaRealitas is map
        && data.analisisAkarMasalah is list
        && data.masalahUtama is string
        && data.tingkatRisiko is number
        && data.tingkatKepercayaanAI is number
        && data.skenario is list
        && data.rekomendasiSkenario is string
        && data.zebra is map
        && (!('evaluasiMingguan' in data) || data.evaluasiMingguan == null || data.evaluasiMingguan is map);
    }

    function isValidEvaluation(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.sessionId is string
        && data.status is string
        && data.cerita is string
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidSession(request.resource.data);
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isValidSession(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidEvaluation(request.resource.data);
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isValidEvaluation(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
